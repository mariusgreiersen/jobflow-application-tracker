# Supabase project settings (Project Settings -> API).
# Both values are public by design: access is controlled by Row Level Security.
# Leave them empty to run JobFlow in demo-only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the deployed app, used in auth email links.
# Optional locally (falls back to the request origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never add the Supabase service-role key here. JobFlow does not need it.
